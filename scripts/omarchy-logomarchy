#!/bin/bash
# Generate an Omarchy logo wallpaper in any theme's colors.
#
# Output lives in ~/.config/omarchy/backgrounds/<theme>/, which Omarchy
# already includes when choosing and cycling a theme's backgrounds, so
# nothing inside the theme itself is touched.
set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$HOME/.local/state/omarchy/current"
USER_THEMES="$CONFIG_HOME/omarchy/themes"
STOCK_THEMES="$OMARCHY_PATH/themes"
USER_BACKGROUNDS="${LOGOMARCHY_BACKGROUNDS:-$CONFIG_HOME/omarchy/backgrounds}"
LOGO_SVG="${LOGOMARCHY_LOGO:-$OMARCHY_PATH/logo.svg}"
PLUGIN_ID="payton.logomarchy"

# Stock logo wallpapers are 3840x2160 with the logo ~1600px wide. The SVG
# is drawn on a 15-unit pixel grid (81 cells wide), so whole-pixel cells
# keep the edges crisp.
WIDTH=3840
HEIGHT=2160
SIZES=(default small xsmall)

SIZE_LABELS=(Default Small "Extra small")

# Field is the wallpaper. Logo is the mark. An option is offered only when
# the theme defines its color (not every theme has "muted").
FIELD_IDS=(dark muted light accent)
FIELD_LABELS=(Dark Muted Light Accent)
LOGO_IDS=(accent foreground contrast background)
LOGO_LABELS=(Accent Foreground Contrast Background)

declare -A COLOR=()
PARSED_FIELD=""
PARSED_LOGO=""

cell_px() {
  case "$1" in
    default) echo 20 ;;
    small) echo 12 ;;
    xsmall) echo 7 ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<EOF
Usage:
  omarchy-logomarchy generate [--theme <slug>] [--size default|small|xsmall]
                            [--field <field>] [--logo <logo>]
                            [--style dark|light|accent|<logo>] [--set]
  omarchy-logomarchy auto [<slug>]    Theme-set hook: default logo if none exists
  omarchy-logomarchy remove [--theme <slug>]
  omarchy-logomarchy get [--json]     Logo wallpaper state for the current theme
  omarchy-logomarchy panel            Open the picker panel

Field is the wallpaper color, logo is the mark. Both come from the theme
palette. --style is the original three pairings, or a logo color on the
dark field.

  dark      background field, accent logo (the stock wallpapers)
  light     lighter of background/foreground behind the mark, darker on it
  accent    accent field, logo in the theme background color
EOF
}

die() {
  echo "omarchy-logomarchy: $*" >&2
  exit 1
}

current_theme() {
  cat "$STATE_DIR/theme.name" 2>/dev/null || true
}

valid_slug() {
  [[ -n $1 && $1 != .* && $1 != */* ]]
}

in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ $item == "$needle" ]] && return 0
  done
  return 1
}

# Prints the path of a colors.toml for the theme, deriving one from
# alacritty.toml for older themes (the same fallback omarchy-theme-set uses).
theme_colors_file() {
  local slug="$1" dir scratch

  if [[ $slug == "$(current_theme)" && -f $STATE_DIR/theme/colors.toml ]]; then
    echo "$STATE_DIR/theme/colors.toml"
    return
  fi

  for dir in "$USER_THEMES/$slug" "$STOCK_THEMES/$slug"; do
    if [[ -f $dir/colors.toml ]]; then
      echo "$dir/colors.toml"
      return
    fi
  done

  for dir in "$USER_THEMES/$slug" "$STOCK_THEMES/$slug"; do
    if [[ -f $dir/alacritty.toml && ! -L $dir/alacritty.toml ]]; then
      scratch=$(mktemp -d)
      cp "$dir/alacritty.toml" "$scratch/"
      omarchy-theme-colors-from-alacritty "$scratch" >/dev/null 2>&1 || true
      if [[ -f $scratch/colors.toml ]]; then
        echo "$scratch/colors.toml"
        return
      fi
    fi
  done

  return 1
}

color_value() {
  local file="$1" key="$2"
  sed -nE "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*\"?(#[0-9A-Fa-f]{6})([0-9A-Fa-f]{2})?\"?.*/\1/p" "$file" | head -n1
}

# Integer relative luminance, 0–255.
luma() {
  local hex=${1#\#}
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  echo $(( (2126 * r + 7152 * g + 722 * b) / 10000 ))
}

lighter_hex() {
  if (( $(luma "$1") >= $(luma "$2") )); then echo "$1"; else echo "$2"; fi
}

darker_hex() {
  if (( $(luma "$1") <= $(luma "$2") )); then echo "$1"; else echo "$2"; fi
}

hex_eq() {
  [[ ${1,,} == "${2,,}" ]]
}

load_theme_colors() {
  local slug="$1" file key val
  file=$(theme_colors_file "$slug") || return 1
  COLOR=()
  while IFS= read -r key; do
    val=$(color_value "$file" "$key")
    [[ -n $val ]] && COLOR["$key"]=$val
  done < <(sed -nE 's/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\1/p' "$file")
  [[ -n ${COLOR[background]:-} ]] || return 1
  [[ -n ${COLOR[accent]:-} ]] || COLOR[accent]=${COLOR[foreground]:-}
  [[ -n ${COLOR[accent]:-} ]]
}

field_hex() {
  local bg=${COLOR[background]:-} fg=${COLOR[foreground]:-}
  case "$1" in
    dark) echo "$bg" ;;
    muted) echo "${COLOR[muted]:-}" ;;
    light)
      [[ -n $bg && -n $fg ]] || return 0
      lighter_hex "$bg" "$fg"
      ;;
    accent) echo "${COLOR[accent]:-}" ;;
  esac
}

logo_hex() {
  local bg=${COLOR[background]:-} fg=${COLOR[foreground]:-}
  case "$1" in
    accent) echo "${COLOR[accent]:-}" ;;
    contrast)
      [[ -n $bg && -n $fg ]] || return 0
      darker_hex "$bg" "$fg"
      ;;
    foreground) echo "$fg" ;;
    background) echo "$bg" ;;
  esac
}

# Same color on the field and the mark would erase the logo.
adjust_logo() {
  local field_h="$1" logo_h="$2" alt
  if [[ -z $field_h || -z $logo_h ]] || ! hex_eq "$field_h" "$logo_h"; then
    echo "$logo_h"
    return
  fi
  for alt in "${COLOR[foreground]:-}" "${COLOR[background]:-}" "${COLOR[accent]:-}"; do
    [[ -n $alt ]] || continue
    hex_eq "$alt" "$field_h" && continue
    echo "$alt"
    return
  done
  echo "$logo_h"
}

variant_token() {
  local field="$1" logo="$2"
  if [[ $field == dark && $logo == accent ]]; then echo dark
  elif [[ $field == light && $logo == contrast ]]; then echo light
  elif [[ $field == accent && $logo == background ]]; then echo accent
  else echo "${field}-${logo}"
  fi
}

parse_variant() {
  local rest="$1"
  case "$rest" in
    dark) PARSED_FIELD=dark; PARSED_LOGO=accent ;;
    light) PARSED_FIELD=light; PARSED_LOGO=contrast ;;
    accent) PARSED_FIELD=accent; PARSED_LOGO=background ;;
    *-*)
      PARSED_FIELD=${rest%%-*}
      PARSED_LOGO=${rest#*-}
      in_list "$PARSED_FIELD" "${FIELD_IDS[@]}" || return 1
      in_list "$PARSED_LOGO" "${LOGO_IDS[@]}" || return 1
      ;;
    *) return 1 ;;
  esac
}

json_options() {
  local kind="$1"
  local -n ids=$2
  local -n labels=$3
  local i hex out='[]' line
  for i in "${!ids[@]}"; do
    if [[ $kind == field ]]; then
      hex=$(field_hex "${ids[$i]}")
    else
      hex=$(logo_hex "${ids[$i]}")
    fi
    [[ -n $hex ]] || continue
    line=$(jq -cn --arg value "${ids[$i]}" --arg label "${labels[$i]}" --arg hex "$hex" \
      '{value:$value,label:$label,hex:$hex}')
    out=$(jq -cn --argjson arr "$out" --argjson item "$line" '$arr + [$item]')
  done
  printf '%s' "$out"
}

json_sizes() {
  local i out=()
  for i in "${!SIZES[@]}"; do
    out+=("$(jq -cn --arg value "${SIZES[$i]}" --arg label "${SIZE_LABELS[$i]}" \
      --argjson cells "$(cell_px "${SIZES[$i]}")" '{value:$value,label:$label,cellPx:$cells}')")
  done
  printf '%s\n' "${out[@]}" | jq -cs .
}

# The logo color each field/logo pairing really renders with, keyed
# "field:logo", so the panel preview matches adjust_logo exactly.
json_pairs() {
  local f l bg raw
  for f in "${FIELD_IDS[@]}"; do
    bg=$(field_hex "$f")
    [[ -n $bg ]] || continue
    for l in "${LOGO_IDS[@]}"; do
      raw=$(logo_hex "$l")
      [[ -n $raw ]] || continue
      printf '%s:%s\t%s\t%s\n' "$f" "$l" "$bg" "$(adjust_logo "$bg" "$raw")"
    done
  done | jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: {field: .[1], logo: .[2]}}) | from_entries'
}

logo_files() {
  local slug="$1"
  [[ -d $USER_BACKGROUNDS/$slug ]] || return 0
  find "$USER_BACKGROUNDS/$slug" -maxdepth 1 -type f -name 'omarchy-logo-*.png' | sort
}

theme_ships_logo() {
  local slug="$1" dir
  for dir in "$USER_THEMES/$slug/backgrounds" "$STOCK_THEMES/$slug/backgrounds"; do
    [[ -d $dir ]] || continue
    if find "$dir" -maxdepth 1 -type f -iname '*omarchy*' | grep -q .; then
      return 0
    fi
  done
  return 1
}

render() {
  local slug="$1" size="$2" field="$3" logo="$4"
  local logo_bg logo_fg raw_logo cell x y svg inner out tmp token

  load_theme_colors "$slug" || die "no colors found for theme '$slug'"
  in_list "$field" "${FIELD_IDS[@]}" || die "field must be one of: ${FIELD_IDS[*]}"
  in_list "$logo" "${LOGO_IDS[@]}" || die "logo must be one of: ${LOGO_IDS[*]}"
  logo_bg=$(field_hex "$field")
  raw_logo=$(logo_hex "$logo")
  [[ -n $logo_bg ]] || die "theme '$slug' has no $field color"
  [[ -n $raw_logo ]] || die "theme '$slug' has no $logo color"
  logo_fg=$(adjust_logo "$logo_bg" "$raw_logo")

  cell=$(cell_px "$size")
  x=$(((WIDTH - 81 * cell) / 2))
  y=$(((HEIGHT - 19 * cell) / 2))
  token=$(variant_token "$field" "$logo")

  mkdir -p "$USER_BACKGROUNDS/$slug"
  out="$USER_BACKGROUNDS/$slug/omarchy-logo-$size-$token.png"
  tmp=$(mktemp --suffix=.png)

  # One rsvg pass draws the field and the scaled logo together.
  svg=$(<"$LOGO_SVG")
  inner=${svg#*>}
  inner=${inner%</svg>*}
  printf '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d"><rect width="%d" height="%d" fill="%s"/><g transform="translate(%d %d) scale(%s)">%s</g></svg>' \
    "$WIDTH" "$HEIGHT" "$WIDTH" "$HEIGHT" "$logo_bg" "$x" "$y" "$(awk -v c="$cell" 'BEGIN { printf "%.6f", c / 15 }')" \
    "${inner//fill=\"#000\"/fill=\"$logo_fg\"}" |
    rsvg-convert -f png -o "$tmp"

  # One logo wallpaper per theme: drop the previous variant.
  logo_files "$slug" | while read -r old; do
    [[ $old == "$out" ]] || rm -f "$old"
  done
  mv "$tmp" "$out"

  echo "$out"
}

set_background() {
  omarchy-theme-bg-set "$1" >/dev/null 2>&1 || true
}

cmd_generate() {
  local slug="" size=default style="" field_flag="" logo_flag="" set=0
  local field logo out

  while (($#)); do
    case "$1" in
      --theme) slug="${2:-}"; shift 2 ;;
      --size) size="${2:-}"; shift 2 ;;
      --style) style="${2:-}"; shift 2 ;;
      --field) field_flag="${2:-}"; shift 2 ;;
      --logo) logo_flag="${2:-}"; shift 2 ;;
      --set) set=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [[ -n $slug ]] || slug=$(current_theme)
  valid_slug "$slug" || die "invalid theme: '$slug'"
  in_list "$size" "${SIZES[@]}" || die "size must be one of: ${SIZES[*]}"

  case "$style" in
    ""|dark) field=dark; logo=accent ;;
    light) field=light; logo=contrast ;;
    accent) field=accent; logo=background ;;
    *)
      if in_list "$style" "${LOGO_IDS[@]}"; then
        field=dark
        logo=$style
      else
        die "style must be one of: dark light accent ${LOGO_IDS[*]}"
      fi
      ;;
  esac
  [[ -n $field_flag ]] && field=$field_flag
  [[ -n $logo_flag ]] && logo=$logo_flag

  out=$(render "$slug" "$size" "$field" "$logo")
  if ((set)) && [[ $slug == "$(current_theme)" ]]; then
    set_background "$out"
  fi
  echo "$out"
}

# Runs after every theme change. Leaves any variant the user picked alone,
# and skips themes that already ship their own Omarchy logo wallpaper.
cmd_auto() {
  local slug="${1:-$(current_theme)}" out current

  valid_slug "$slug" || exit 0
  logo_files "$slug" | grep -q . && exit 0
  theme_ships_logo "$slug" && exit 0

  out=$(render "$slug" default dark accent) || exit 0

  # A theme with no backgrounds of its own left the previous theme's
  # wallpaper up; show the new logo instead.
  current=$(readlink -f "$STATE_DIR/background" 2>/dev/null || true)
  if [[ $slug == "$(current_theme)" ]] &&
    [[ -z $current || ! -f $current || ($current != "$STATE_DIR/theme/"* && $current != "$USER_BACKGROUNDS/$slug/"*) ]]; then
    set_background "$out"
  fi
}

cmd_remove() {
  local slug="" current

  while (($#)); do
    case "$1" in
      --theme) slug="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -n $slug ]] || slug=$(current_theme)
  valid_slug "$slug" || die "invalid theme: '$slug'"

  current=$(readlink -f "$STATE_DIR/background" 2>/dev/null || true)
  logo_files "$slug" | while read -r f; do rm -f "$f"; done
  rmdir "$USER_BACKGROUNDS/$slug" 2>/dev/null || true

  if [[ $slug == "$(current_theme)" && -n $current && ! -f $current ]]; then
    omarchy-theme-bg-next >/dev/null 2>&1 || true
  fi
}

cmd_get() {
  local slug file="" size="" style="" field="" logo="" active=false current
  local fields='[]' logos='[]' pairs='{}' sizes='[]' adjusted=false
  local logo_bg raw_logo resolved
  slug=$(current_theme)
  file=$(logo_files "$slug" | head -n1)
  current=$(readlink -f "$STATE_DIR/background" 2>/dev/null || true)

  if [[ -n $file ]]; then
    local name=${file##*/}
    name=${name#omarchy-logo-}
    name=${name%.png}
    size=${name%%-*}
    local rest=${name#*-}
    if in_list "$size" "${SIZES[@]}" && parse_variant "$rest"; then
      field=$PARSED_FIELD
      logo=$PARSED_LOGO
      style=$(variant_token "$field" "$logo")
    else
      size=""
    fi
    [[ $current == "$file" ]] && active=true
  fi

  if load_theme_colors "$slug"; then
    fields=$(json_options field FIELD_IDS FIELD_LABELS)
    logos=$(json_options logo LOGO_IDS LOGO_LABELS)
    pairs=$(json_pairs)
    if [[ -n $field && -n $logo ]]; then
      logo_bg=$(field_hex "$field")
      raw_logo=$(logo_hex "$logo")
      resolved=$(adjust_logo "$logo_bg" "$raw_logo")
      if [[ -n $raw_logo && -n $resolved ]] && ! hex_eq "$raw_logo" "$resolved"; then
        adjusted=true
      fi
    fi
  fi

  if [[ ${1:-} == --json ]]; then
    sizes=$(json_sizes)
    jq -cn --rawfile logoSvg "$LOGO_SVG" --argjson sizes "$sizes" --argjson pairs "$pairs" \
      --argjson canvas "[$WIDTH,$HEIGHT]" \
      --arg theme "$slug" --arg file "$file" --arg size "$size" \
      --arg style "$style" --arg field "$field" --arg logo "$logo" \
      --argjson active "$active" \
      --argjson shipsLogo "$(theme_ships_logo "$slug" && echo true || echo false)" \
      --argjson fields "$fields" --argjson logos "$logos" \
      --argjson adjusted "$adjusted" \
      '{theme:$theme, file:$file, size:$size, style:$style, field:$field, logo:$logo,
        active:$active, shipsLogo:$shipsLogo, fields:$fields, logos:$logos, adjusted:$adjusted,
        sizes:$sizes, pairs:$pairs, logoSvg:$logoSvg, canvas:$canvas}'
  else
    echo "theme:  $slug"
    echo "file:   ${file:-none}"
    [[ -n $file ]] && echo "size:   $size" && echo "style:  $style" && echo "field:  $field" && echo "logo:   $logo" && echo "active: $active"
  fi
}

case "${1:-}" in
  generate) shift; cmd_generate "$@" ;;
  auto) shift; cmd_auto "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  get) shift; cmd_get "$@" ;;
  panel) omarchy-shell shell summon "$PLUGIN_ID" "{}" ;;
  -h | --help | help) usage ;;
  *) usage >&2; exit 1 ;;
esac
